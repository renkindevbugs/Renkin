<?xml version="1.0" encoding="utf-8"?>
<!-- No-op animation: see values-v31/themes.xml for why the splash icon is an animated vector. -->
<animated-vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:drawable="@drawable/launch_splash_symbol">
    <target android:name="symbol">
        <aapt:attr name="android:animation">
            <objectAnimator
                android:duration="1"
                android:propertyName="alpha"
                android:valueFrom="1"
                android:valueTo="1" />
        </aapt:attr>
    </target>
</animated-vector>
