<?xml version="1.0" encoding="utf-8"?>
<!--
    Backup / transfer rules for Android 12 (API 31) and above. Everything is backed up by default;
    we only exclude the local crash logs (transient diagnostics, pointless on another device). The
    generated-icon database, the user's uploaded images and the app settings are intentionally kept.
    See https://developer.android.com/about/versions/12/backup-restore#xml-changes
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="file" path="crashes" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="file" path="crashes" />
    </device-transfer>
</data-extraction-rules>
